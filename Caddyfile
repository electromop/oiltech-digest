# Reverse-proxy + авто-HTTPS для OilTech Digest.
# Caddy сам получает и продлевает сертификат Let's Encrypt для домена и
# редиректит http→https. Требуется: DNS A-запись oiltech-digest.ru → IP сервера
# и открытые порты 80/443. Сертификаты хранятся в томе caddy_data (см. compose).

(oiltech_routes) {
	# Сжатие ответов API/статики — критично для доступа через VPN/из-за рубежа:
	# JSON каталога сигналов (тысячи строк) ужимается в ~5–10 раз.
	encode zstd gzip

	# Справка /help (сервис docs) — архивный модуль с 23.09: сервис в профиле compose
	# `archive`. Блок снят, иначе без контейнера /help отвечал бы 502. Вернуть — поднять
	# docs профилем `archive` и раскомментировать:
	# handle /help* {
	# 	reverse_proxy docs:8000
	# }

	reverse_proxy app:8000
}

oiltech-digest.ru {
	import oiltech_routes
}

# Единый контур (D, 28.09): агентного стека больше нет — радар и агент источников
# живут в этом же приложении. Старый адрес ведёт на основной с тем же путём. Редирект
# временный (302): браузер его не запоминает, и откат в первую неделю остаётся чистым.
agents.oiltech-digest.ru {
	redir https://oiltech-digest.ru{uri} 302
}

:80 {
	import oiltech_routes
}

# Если понадобится www — раскомментируй (и добавь DNS-запись для www):
# www.oiltech-digest.ru {
# 	redir https://oiltech-digest.ru{uri} permanent
# }
