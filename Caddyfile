# Reverse-proxy + авто-HTTPS для OilTech Digest.
# Caddy сам получает и продлевает сертификат Let's Encrypt для домена и
# редиректит http→https. Требуется: DNS A-запись oiltech-digest.ru → IP сервера
# и открытые порты 80/443. Сертификаты хранятся в томе caddy_data (см. compose).

(oiltech_routes) {
	# Сжатие ответов API/статики, критично для доступа через VPN/из-за рубежа:
	# JSON каталога сигналов (тысячи строк) ужимается в ~5-10 раз.
	encode zstd gzip

	# Предел тела запроса (защита входа 16.11.2026), сверх него 413. Числа и почему они такие: oiltech_digest/request_guard.py,
	# там же второй слой в приложении; тест сверяет числа с этим файлом. После правки файла:
	# docker exec -i oiltech_caddy caddy reload --config /dev/stdin --adapter caddyfile < Caddyfile
	@auth_body path /api/auth/*
	request_body @auth_body {
		max_size 64KB
	}
	@large_body path /api/documents /api/external-worker/*
	request_body @large_body {
		max_size 32MB
	}
	@exchange_body path /api/exchange/*
	request_body @exchange_body {
		max_size 1MB
	}
	@other_body not path /api/auth/* /api/documents /api/external-worker/* /api/exchange/*
	request_body @other_body {
		max_size 2MB
	}

	# Точка обмена с потребителем выпуска (#198): только с его адресов, остальным 403 до приложения. Адреса приходят
	# одной переменной окружения контейнера caddy, EXCHANGE_CONSUMER_IPS из .env ядра (docker-compose.yml): IP или сеть
	# через пробел, запятая роняет Caddy. Пусто: точка закрыта всем. Смена адреса: правка .env и пересоздание контейнера
	# caddy (caddy reload переменные окружения не перечитывает). Второй слой, адрес и токен: приложение
	# (api_access.exchange_point_refusal).
	@exchange_refused {
		path /api/exchange/*
		not remote_ip {$EXCHANGE_CONSUMER_IPS}
	}
	respond @exchange_refused "Точка обмена закрыта для этого адреса" 403

	reverse_proxy app:8000
}

oiltech-digest.ru {
	import oiltech_routes
}

# Единый контур (D, 28.09): агентного стека больше нет, радар живёт в этом же приложении. Старый адрес ведёт на основной с тем же путём. Редирект
# временный (302): браузер его не запоминает, и откат в первую неделю остаётся чистым.
agents.oiltech-digest.ru {
	redir https://oiltech-digest.ru{uri} 302
}

:80 {
	import oiltech_routes
}

# Если понадобится www, раскомментируй (и добавь DNS-запись для www):
# www.oiltech-digest.ru {
# 	redir https://oiltech-digest.ru{uri} permanent
# }
